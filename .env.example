# ⚠️ SECURITY WARNING ⚠️
# Chronos MCP stores credentials in PLAIN TEXT at ~/.chronos/accounts.json
# Only use on trusted systems with proper file permissions!
# See SECURITY.md for details and mitigation strategies

# Example environment configuration for Chronos MCP
# Copy this to .env and update with your CalDAV server details

# Default CalDAV account (for backward compatibility)
CALDAV_BASE_URL=http://your-caldav-server.com:5232
CALDAV_USERNAME=your_username
CALDAV_PASSWORD=your_password

# For multiple accounts, use ~/.chronos/accounts.json instead

# --- HTTP Transport Configuration ---
# Set CHRONOS_TRANSPORT to enable HTTP transport (supports SSE and Streamable HTTP).
# When not set, the server uses stdio transport (standard MCP behavior).
# CHRONOS_TRANSPORT=http        # "http" | "sse" | "streamable-http"
# CHRONOS_HOST=::               # Bind address (default "::" = all interfaces)
# CHRONOS_PORT=8000             # Bind port (default 8000)

# Token-based authentication for HTTP transport.
# When set, every request must include this token as ?token=<value> in the
# query string or as a Bearer token in the Authorization header.
# CHRONOS_AUTH_TOKEN=your-secret-token-here
